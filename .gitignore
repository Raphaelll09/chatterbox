# Ignore entries in TTS interface repo
__pycache__/
*.AU
*.zip
*.vtt
audio_file.wav
audio_file_duration_alignment.json

# Ignore LIVE profiling output. profile/ is scratch: every profiled run writes here
# (config_tts.yaml -> profiling.output_dir). Committed historical runs live in
# research/data/archive/ instead and are NOT covered by this rule.
#
# The previous patterns (profile/*.csv, profile/*.jsonl, ...) were one level short: they
# matched only the top of profile/, never profile/<run>/..., which is how ~180 run files
# ended up committed. Ignoring the whole directory is the fix.
profile/

# Ignore this AI-assistant tool's own knowledge-graph cache (build artifact, not project source)
graphify-out/

# Ignore dataset, models and training script in FastSpeech2
assets/models/FastSpeech2/__pycache__/
assets/models/FastSpeech2/config/
assets/models/FastSpeech2/output/
assets/models/FastSpeech2/preprocessed_data/
assets/models/FastSpeech2/save_preprocessed_data/
assets/models/FastSpeech2/*.mat

# Ignore models in Hifi-GAN
assets/models/hifi-gan-master/__pycache__/
assets/models/hifi-gan-master/FR_V2/

# Ignore models in FlauBERT. The whole directory is untracked: it used to be recorded as a
# gitlink (mode 160000) with no .gitmodules entry, so every fresh clone got an empty folder
# and `git submodule` errored out. It is now treated exactly like the FastSpeech2/HiFi-GAN
# weights -- a documented manual download (see INSTALL.md / README.md).
assets/models/flaubert/flaubert_large_cased/

# Ignore Piper voices (fetched by scripts/fetch_piper_voices.sh -- see
# chatterbox/synthesis/backends/piper/README.md for provenance/sha256)
assets/models/Piper/*.onnx
assets/models/Piper/*.onnx.json
assets/models/Piper/output/

# Ignore AI-assistant session state
.claude/

# Ignore Virtual Env
python3.11.1_embedded_tts/
.venv/