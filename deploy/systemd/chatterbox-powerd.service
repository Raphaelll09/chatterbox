# chatterbox-powerd systemd unit (chatterbox-powerd_spec_v0.1.md Sec8).
#
# Installed by scripts/setup_pi.sh into /etc/systemd/system/ -- see docs/power/POWERD.md.
#
# Deviates from the literal spec in one way: ExecStart/WorkingDirectory point at the venv
# scripts/setup_pi.sh actually creates (~/chatterbox/venv), not /usr/bin/python3 -- the system
# interpreter has none of requirements-pi.txt installed. Path below is set for this deployment's
# actual account (chatterbox) -- adjust both units together if you reuse this on a Pi with a
# different deployment user or clone location.
[Unit]
Description=Chatterbox power-state daemon
After=multi-user.target

[Service]
Type=simple
WorkingDirectory=/home/chatterbox/chatterbox
ExecStart=/home/chatterbox/chatterbox/venv/bin/python3 -m chatterbox.power.daemon
Restart=always
RestartSec=2
# Group= is required alongside RuntimeDirectory=: systemd creates /run/chatterbox owned by
# User=/Group=, falling back to root's own primary group (root) if Group is left unset -- which
# would make the directory inaccessible to any non-root client regardless of the socket file's own
# chown (chatterbox/power/ipc.py:_chmod_and_chown() only touches the socket file, not its parent
# directory).
RuntimeDirectory=chatterbox
RuntimeDirectoryMode=0750
User=root
Group=chatterbox
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
